#!/bin/bash
# Fetch, cache and reduce the official Omarchy plugin marketplace catalog.
#
# The upstream feed (https://plugins.omarchy.org/catalog.json) is ~5.4MB of JSON
# describing every listed plugin. Handing that to the QML JSON parser on every
# panel open is wasteful, so this reduces it to the ~1MB the UI actually reads
# and caches both. GitHub Pages serves a strong ETag and max-age=600, so the
# refresh path is a conditional GET that comes back 304 with an empty body.
#
# Usage: pm-catalog [--refresh] [--detail <plugin-id>]
#   (default)          reduced index from cache, refreshed if older than max-age
#   --refresh          force a conditional GET before emitting
#   --detail <id>      full catalog record for one plugin, from cache
#
# Always exits 0 when it can emit something: a stale cache beats an error
# dialog. The "stale" and "online" fields tell the UI what it is looking at.

set -uo pipefail

CATALOG_URL="https://plugins.omarchy.org/catalog.json"
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/io.github.omarcodehub.plugin-manager"
FULL="$CACHE_DIR/catalog.json"
ETAG="$CACHE_DIR/catalog.etag"
INDEX="$CACHE_DIR/index.json"
MAX_AGE=600

# 32 MiB. The feed is about 5.4 MB decompressed today, so this is ample
# headroom while still bounding what a hostile or broken origin can make this
# write and parse.
MAX_BYTES=$((32 * 1024 * 1024))

FORCE=0
DETAIL=""

while (($# > 0)); do
  case "$1" in
  --refresh) FORCE=1; shift ;;
  --detail) DETAIL="${2:-}"; shift 2 ;;
  -h | --help) sed -n '2,20p' "$0"; exit 0 ;;
  *) echo "pm-catalog: unknown argument: $1" >&2; exit 2 ;;
  esac
done

mkdir -p "$CACHE_DIR"

cache_age() {
  [[ -s $FULL ]] || { echo 999999; return; }
  local now mtime
  now=$(date +%s)
  mtime=$(stat -c %Y "$FULL" 2>/dev/null || echo 0)
  echo $((now - mtime))
}

# Downloads are bounded on both axes, because a deadline does not bound size:
# a fast or highly compressible response can fill the disk long before
# --max-time expires.
#
#   --proto '=https'  nothing but HTTPS, ever
#   no -L             redirects are refused outright rather than constrained;
#                     the canonical URL answers 200 directly, so following them
#                     buys nothing and widens where the bytes may come from
#   --max-filesize    rejects a response whose announced length is too large,
#                     before any of it is transferred
#   head -c MAX+1     bounds what actually reaches the disk. This is the control
#                     that matters: for a chunked or compressed body the real
#                     size is only known as it arrives, and this caps the
#                     DECOMPRESSED bytes, which is what jq would then parse.
#
# Reading one byte past the cap is deliberate — it is how an oversized response
# is detected rather than silently truncated into something jq might accept.
refresh() {
  local tmp hdr code size rc
  tmp=$(mktemp "$CACHE_DIR/.catalog.XXXXXX") || return 1
  hdr=$(mktemp "$CACHE_DIR/.hdr.XXXXXX") || { rm -f "$tmp"; return 1; }

  curl -s --proto '=https' --compressed --max-time 45 \
    --max-filesize "$MAX_BYTES" \
    --etag-compare "$ETAG" --etag-save "$ETAG" \
    -D "$hdr" "$CATALOG_URL" 2>/dev/null \
    | head -c "$((MAX_BYTES + 1))" >"$tmp"
  rc=${PIPESTATUS[0]}

  code=$(awk 'toupper($1) ~ /^HTTP/ { c = $2 } END { print c + 0 }' "$hdr" 2>/dev/null)
  size=$(stat -c %s "$tmp" 2>/dev/null || echo 0)
  rm -f "$hdr"

  # Over the cap: head let one byte past through, so the body was too big.
  if ((size > MAX_BYTES)); then
    echo "pm-catalog: refusing a catalog larger than $MAX_BYTES bytes" >&2
    rm -f "$tmp" "$ETAG"
    return 1
  fi

  case "$code" in
  200)
    # curl exit 63 is --max-filesize; anything non-zero means an incomplete body.
    if ((rc != 0)); then
      rm -f "$tmp" "$ETAG"
      return 1
    fi
    if jq -e 'has("plugins") and (.plugins | type == "array")' "$tmp" >/dev/null 2>&1; then
      mv -f "$tmp" "$FULL"
      rm -f "$INDEX"
      return 0
    fi
    # A truncated or HTML error body must never replace a good cache, and the
    # ETag that produced it must not survive to earn a 304 next time.
    rm -f "$tmp" "$ETAG"
    return 1
    ;;
  304)
    rm -f "$tmp"
    # Not modified since *what*? If the cache is gone the saved ETag is lying,
    # and touching $FULL here would mint an empty file that later runs would
    # treat as a valid catalog. Drop the ETag and fail so the next attempt is a
    # full GET.
    if [[ ! -s $FULL ]]; then
      rm -f "$ETAG" "$FULL"
      return 1
    fi
    touch "$FULL" 2>/dev/null
    return 0
    ;;
  *)
    rm -f "$tmp" "$ETAG"
    return 1
    ;;
  esac
}

ONLINE=false
if ((FORCE)) || [[ ! -s $FULL ]] || (($(cache_age) > MAX_AGE)); then
  if refresh; then ONLINE=true; fi
else
  ONLINE=true
fi

if [[ ! -s $FULL ]]; then
  echo '{"ok":false,"online":false,"stale":true,"error":"no catalog cached and the marketplace is unreachable","generatedAt":"","plugins":[]}'
  exit 0
fi

if [[ -n $DETAIL ]]; then
  jq -c --arg id "$DETAIL" '.plugins[] | select(.id == $id)' "$FULL" 2>/dev/null || echo 'null'
  exit 0
fi

# Rebuild the reduced index only when the full catalog is newer than it.
if [[ ! -f $INDEX || $FULL -nt $INDEX ]]; then
  tmp=$(mktemp "$CACHE_DIR/.index.XXXXXX") || exit 1
  if jq -c '{
      generatedAt: (.generatedAt // ""),
      plugins: [ .plugins[] | {
        id, name, author, category, kind, version,
        description: (.description // ""),
        tags: (.tags // []),
        license: (.license // ""),
        installNote: (.installNote // ""),
        shot: (.previewImage // ""),
        repo: (.repo // ""),
        stars: (.stars // 0),
        verified: (.verificationStatus == "verified"),
        installable: (.installAvailable // false),
        builtIn: (.builtIn // false),
        initials: (.initials // ""),
        accent: (.accent // ""),
        thumb: (.previewThumbnail // ""),
        reviewedCommit: (.upstreamValidatedCommit // .listingValidatedCommit // ""),
        observedCommit: (.upstreamObservedCommit // ""),
        repoUpdatedAt: (.repositoryUpdatedAt // "")
      } ]
    }' "$FULL" >"$tmp" 2>/dev/null; then
    mv -f "$tmp" "$INDEX"
  else
    rm -f "$tmp"
    echo '{"ok":false,"online":false,"stale":true,"error":"cached catalog could not be parsed","generatedAt":"","plugins":[]}'
    exit 0
  fi
fi

age=$(cache_age)
stale=false
((age > MAX_AGE)) && stale=true

jq -c --argjson online "$ONLINE" --argjson stale "$stale" --argjson age "$age" \
  '. + {ok: true, online: $online, stale: $stale, ageSeconds: $age, count: (.plugins | length)}' \
  "$INDEX"
