#!/bin/bash
# Engagement counts from the marketplace: hearts, views and copy-installs.
#
# These do not ship in catalog.json. They live behind the marketplace's own API
# (https://api.omarchyplugins.com/v1/stats), which returns every plugin's totals
# in one ~36KB document keyed by plugin id.
#
# The API sends `cache-control: no-store` and offers no ETag, so there is no
# conditional GET to make -- this caches locally on a short TTL instead, which
# is enough to keep opening the panel from hammering it.
#
# Usage: pm-stats [--refresh]
#
# Always exits 0 when it can emit something. Hearts are decoration: if the API
# is down the panel should still browse and install, so a failure degrades to
# `{"ok":false,...,"plugins":{}}` rather than an error.

set -uo pipefail

STATS_URL="https://api.omarchyplugins.com/v1/stats"
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/io.github.omarcodehub.plugin-manager"
STATS="$CACHE_DIR/stats.json"
MAX_AGE=300

# 8 MiB. The document is about 40 KB today; this bounds what a hostile or
# broken origin can make this write and parse.
MAX_BYTES=$((8 * 1024 * 1024))

FORCE=0
while (($# > 0)); do
  case "$1" in
  --refresh) FORCE=1; shift ;;
  -h | --help) sed -n '2,16p' "$0"; exit 0 ;;
  *) echo "pm-stats: unknown argument: $1" >&2; exit 2 ;;
  esac
done

mkdir -p "$CACHE_DIR"

cache_age() {
  [[ -s $STATS ]] || { echo 999999; return; }
  local now mtime
  now=$(date +%s)
  mtime=$(stat -c %Y "$STATS" 2>/dev/null || echo 0)
  echo $((now - mtime))
}

# Bounded on both axes for the same reason as pm-catalog: a deadline does not
# bound size. No -L (the endpoint answers 200 directly, so redirects are refused
# rather than constrained), HTTPS only, an announced-size rejection, and a hard
# cap on the decompressed bytes that reach the disk.
refresh() {
  local tmp hdr code size rc
  tmp=$(mktemp "$CACHE_DIR/.stats.XXXXXX") || return 1
  hdr=$(mktemp "$CACHE_DIR/.hdr.XXXXXX") || { rm -f "$tmp"; return 1; }

  curl -s --proto '=https' --compressed --max-time 20 \
    --max-filesize "$MAX_BYTES" \
    -D "$hdr" "$STATS_URL" 2>/dev/null \
    | head -c "$((MAX_BYTES + 1))" >"$tmp"
  rc=${PIPESTATUS[0]}

  code=$(awk 'toupper($1) ~ /^HTTP/ { c = $2 } END { print c + 0 }' "$hdr" 2>/dev/null)
  size=$(stat -c %s "$tmp" 2>/dev/null || echo 0)
  rm -f "$hdr"

  if ((size > MAX_BYTES)); then
    echo "pm-stats: refusing a stats document larger than $MAX_BYTES bytes" >&2
    rm -f "$tmp"
    return 1
  fi

  if ((rc != 0)) || [[ $code != 200 ]]; then
    rm -f "$tmp"
    return 1
  fi

  # A truncated or HTML error body must never replace a good cache.
  if jq -e '(.plugins | type) == "object"' "$tmp" >/dev/null 2>&1; then
    mv -f "$tmp" "$STATS"
    return 0
  fi
  rm -f "$tmp"
  return 1
}

ONLINE=false
if ((FORCE)) || [[ ! -s $STATS ]] || (($(cache_age) > MAX_AGE)); then
  if refresh; then ONLINE=true; fi
else
  ONLINE=true
fi

if [[ ! -s $STATS ]]; then
  echo '{"ok":false,"online":false,"count":0,"plugins":{}}'
  exit 0
fi

jq -c --argjson online "$ONLINE" '
  {
    ok: true,
    online: $online,
    count: (.plugins | length),
    plugins: (.plugins | with_entries(.value |= {
      hearts: (.hearts // 0),
      views: (.views // 0),
      copies: (.copies // 0)
    }))
  }' "$STATS" 2>/dev/null || echo '{"ok":false,"online":false,"count":0,"plugins":{}}'
